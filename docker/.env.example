# Docker Compose environment variables for imajev.
# Copy this file to `.env` (in this docker/ directory) and adjust as needed.
# Explicit shell variables override any matching value set here.

# Host port published for the container's internal port 8765.
# Change this to expose the service on a different host port.
HOST_PORT=8765

# Model size to serve: 2b, 4b, or 9b.
MODEL_SIZE=2b

# Candidate option orders averaged per question. 1 reduces latency.
ROTATIONS=4

# Maximum processed request length, in tokens.
MAX_INPUT_TOKENS=4096

# Additional server CLI flags, split by Compose into separate arguments.
# Examples: --fast, --merge-lora, --float32, --thinking auto
# Leave empty for the standard configuration.
SERVER_FLAGS=
